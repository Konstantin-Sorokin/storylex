# Copy to .env in the repository root. Fill both secrets locally.
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

POSTGRES_DB=storylex
POSTGRES_USER=storylex
POSTGRES_PASSWORD=
# Django runs in WSL; Compose publishes PostgreSQL only to loopback.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Stage 1.5: explicit LOCAL development sync only, never production.
STORYLEX_DEV_SYNC_ENABLED=false
STORYLEX_DEV_SYNC_USER_ID=
STORYLEX_DEV_SYNC_TOKEN=
