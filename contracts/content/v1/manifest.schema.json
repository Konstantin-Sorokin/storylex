{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storylex published manifest v1",
  "type": "object",
  "required": ["schema_version", "lesson_engine_version", "product_id", "revision_id", "revision_number", "scope", "counts", "documents"],
  "properties": {
    "schema_version": { "const": 1 },
    "lesson_engine_version": { "const": 1 },
    "product_id": { "type": "string", "format": "uuid" },
    "revision_id": { "type": "string", "format": "uuid" },
    "revision_number": { "type": "integer", "minimum": 1 },
    "scope": { "enum": ["trial", "full"] },
    "counts": {
      "type": "object", "required": ["sections", "lessons", "items"],
      "properties": {
        "sections": { "type": "integer", "minimum": 0 },
        "lessons": { "type": "integer", "minimum": 1 },
        "items": { "type": "integer", "minimum": 5 }
      }
    },
    "documents": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["artifact_id", "section_id", "sha256", "byte_size", "lesson_ids"],
        "properties": {
          "artifact_id": { "type": "string", "format": "uuid" },
          "section_id": { "type": ["string", "null"], "format": "uuid" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "byte_size": { "type": "integer", "minimum": 1, "maximum": 10485760 },
          "lesson_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } }
        }
      }
    }
  }
}
